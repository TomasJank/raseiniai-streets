  [
   "Katilinė vėl rūksta.",
   "Tai ir sąskaitos už šildymą ateis.",
   "Gerai, kad pas mane krosnis.",
   "Užtat tu malkas kapoji."
  ],
  [
   "Kaimynas vėl tujas sodina palei tvorą.",
   "Jau ir taip kaip tvirtovė, nieko nesimato.",
   "Tai gal todėl ir sodina."
  ],
