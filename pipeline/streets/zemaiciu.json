   "Iki centro pėsčiom eini?",
   "Pėsčiom, per Maironio greičiau nei laukt.",
   "Palauk, užvesiu mašiną, pavešiu.",
   "Jei tas tavo kibiras užsives."
  ],
  [
   "Kaimyno katinas vėl mano lysvėj.",
   "Tai bent pelių neturėsi."
  ],
  [
   "Autoservisas šeštadieniais dirba?",
   "Iki antros, ant durų parašyta.",
   "Tai spėsiu padangas pakeist."
  ]
