  [
   "BENU rytoj dirba?",
   "Dirba, nuo aštuonių.",
   "Tai ryte užsuksiu, mamai vaistų reikia."
  ],
  [
   "Vėl lekia kaip per lenktynes.",
   "Vienpusis, tai ir galvoja, kad greitkelis.",
   "Prie parko bent greitį mažintų.",
   "Sumažins, kai ką nors partrenks."
  ],
  [
   "Einam per parką iki Žemaičio?",
   "Einam, paskui kebabų prie Vilniaus.",
   "Tu vis apie tuos kebabus."
  ],
  [
   "Prie cerkvės gražiai sutvarkyta.",
   "Savivaldybė gi čia pat, mato.",
   "Kad visur taip matytų."
  ],
  [
   "Penkiasdešimt rašo, o kas laikosi?",
   "Niekas, bet ženklas gražus."
  ]
