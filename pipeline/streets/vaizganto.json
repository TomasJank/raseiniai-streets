 "flavour": [
  [
   "Prie komisariato vėl stovi su radaru.",
   "Tai ir važiuok penkiasdešimt.",
   "Aš visada penkiasdešimt.",
   "Nu jo, mačiau aš tave."
  ],
  [
   "Eisi šeštadienį į kultūros centrą?",
   "O kas ten bus?",
   "Koncertas, anūkė šoka.",
   "Jei nelis, ateisiu."
  ],
  [
   "Tujas jau apkirpai?",
   "Dar ne, žmona sako po Žolinės.",
   "Mano jau kaip siena užaugo.",
   "Bent dulkių nuo kelio mažiau."
  ],
  [
   "Malkos vėl pabrango.",
   "Kiek dabar už erdmetrį?",
   "Šešiasdešimt, ir dar už atvežimą.",
   "Tai žiemą vėl prie radiatoriaus sėdėsim."
  ],
  [
   "Vilkupis po lietaus vėl išsiliejo.",
   "Prie Pieninės visą pievą apsėmė.",
   "Kasmet tas pats, griovių niekas nevalo."
  ],
  [
   "Kultūros centras kaip balta dėžė stovi.",
   "Bent turi kur anūkei pašokti.",
   "O už jo geltonieji mediniai namai lyg iš kito laiko."
  ]
 ],
