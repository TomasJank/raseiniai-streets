 "street": "Kęstučio g.",
 "slug": "kestucio",
 "flavour": [
  [
   "Tie sunkvežimiai per Kęstučio lekia kaip per greitkelį.",
   "Ženklas gi rodo, kad jau miestas.",
   "Kas jį ten skaito. Tik prie žiedo pristabdo."
  ],
  [
   "Autobusas į centrą dar nepraėjo?",
   "Ką tik nuvažiavo, kitas po valandos.",
   "Tai einu pėsčiom, čia ne taip toli.",
   "Eik palei griovį, šaligatvio nėra."
  ],
  [
   "Matei tuos medinius stulpus prie kelio?",
   "Kasdien pro juos važiuoju.",
   "Gražiai išdrožti, rankų darbas.",
   "Mūsų krašte drožėjų netrūksta."
  ],
  [
   "Vėl vėjas iš laukų, net stotelėj nepasislėpsi.",
   "Tai kad ji iš šono atvira.",
   "Gal kitąmet naują pastatys."
  ]
 ],
