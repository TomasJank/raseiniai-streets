  [
   "Gal užeinam į kebabinę prie IKI?",
   "Vėl kebabo? Vakar valgėm.",
   "Tai kad ten skaniausi Raseiniuose.",
   "Gerai, bet aš be svogūnų."
  ],
  [
   "Kada tavo autobusas į Kauną?",
   "Iš stoties po pusvalandžio.",
   "Tai dar spėsi į Maximą užbėgti.",
   "Spėsiu, jei prie kasų eilės nebus."
  ],
