{
 "street": "Dubysos g.",
 "slug": "dubysos",
 "flavour": [
  [
   "Vėl kažkas mano vietą prie laiptinės užstatė.",
   "Po šešių čia niekada vietų nėra.",
   "Reikės anksčiau iš darbo grįžti.",
   "Arba dviračiu važinėti."
  ],
  [
   "Einu į Lidlą, tau nieko nereikia?",
   "Duonos ir pieno, jei nesunku.",
   "Gerai, užnešiu pakeliui."
  ],
  [
   "Obuolių šiemet tiek, kad nėra kur dėti.",
   "Spausk sultis, aš jau trečią kibirą išspaudžiau.",
   "Neturiu sulčiaspaudės.",
   "Atnešk pas mane, kartu išspausim."
  ],
  [
   "Kada tą Dubysos gatvę pagaliau užlopys?",
   "Kur ten, jau kelinti metai žada.",
   "Tai vėl per duobes šokinėsim."
  ],
  [
   "Savaitgalį važiuojam prie Dubysos su meškerėm?",
   "Jei nelis, važiuojam.",
   "Kirmėlių aš prikasiu."
  ],
  [
   "Prie šviesoforo vėl eilė iki pat Dariaus ir Girėno.",
   "Pėsčiom greičiau nueini.",
   "Tai ko tie visi važiuoja?",
   "Tingi, ko daugiau."
  ]
 ],
