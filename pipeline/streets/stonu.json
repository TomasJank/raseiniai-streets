 "flavour": [
  [
   "Vėl Stonų gatvę perkasė.",
   "Šaligatvį daro, sako, iki vasaros.",
   "Iki kurios vasaros, nepasakė?",
   "Tai va, kad nepasakė."
  ],
  [
   "Į Lidlą eini?",
   "Einu, šiandien kiaušiniai pigesni.",
   "Paimk ir man dešimtį.",
   "Kojas turi, nueisi."
  ],
  [
   "Autobusas į Stonų sodus dar važiuoja?",
   "Važiuoja, tik retai. Lauk prie stotelės.",
   "Ilgai laukt.",
   "Tai eik pėsčiom, netoli."
  ],
  [
   "Sunkvežimiai nuo ryto zuja pro langus.",
   "Iš tų sandėlių prie Dariaus ir Girėno.",
   "Stiklai dreba.",
   "Užtat žmonėms darbo yra."
  ],
  [
   "Raseika prie Molynės pavasarį vėl išsilies.",
   "Kasmet išsilieja.",
   "Rūsį pernai užpylė?",
   "Ne, bet maišų su smėliu jau prisipyliau."
  ]
 ],
