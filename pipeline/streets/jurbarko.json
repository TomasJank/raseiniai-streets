 "flavour": [
  [
   "Vėl fūra į Jurbarką lėkė kaip pašėlusi.",
   "Pagrindinis kelias, ką padarysi.",
   "Prie Vilniaus gatvės kamerą reikėtų.",
   "Kol kas nors nenukentės, nepastatys."
  ],
  [
   "Degalinėj prie išvažiavimo dyzelis vėl pabrango.",
   "Mieste ne ką pigiau.",
   "Tai pilsiu tik pusę bako."
  ],
  [
   "Tujas jau nukirpai?",
   "Dar ne, laukiu sausesnės dienos.",
   "Mano jau aukštesnės už tvorą.",
   "Ir gerai, mažiau dulkių nuo kelio."
  ],
  [
   "Dviračiu iki Jurbarko nemintum?",
   "Takas tik iki ženklo, toliau kelkraštis.",
   "Tai sukam atgal pro beržus."
  ]
 ],
