{
 "street": "Maironio g.",
 "slug": "maironio",
 "flavour": [
  [
   "Į Moki-veži užsuksi?",
   "Reikia dažų tvorai, tai užsuksiu.",
   "Paimk ir man vinių, tų mažų.",
   "Gerai, tik pinigus atiduok."
  ],
  [
   "Parke vakarais vėl jaunimas sėdi.",
   "Tegu sėdi, kol netriukšmauja.",
   "Daugiau jiems nėra kur eit."
  ],
  [
   "Maximoj kiaušiniai vėl pabrango.",
   "Ir sviestas. Viskas brangsta.",
   "Tai šeštadienį į turgų eisiu.",
   "Ten irgi ne pigiau."
  ],
  [
   "Ar čia autobusas į Kauną sustoja?",
   "Ne, eikit į stotį, prie Vilniaus gatvės.",
   "Toli?",
   "Kokios dešimt minučių pėsčiom."
  ],
  [
   "Saldumynų namuose pyragų po pietų dar būna?",
   "Retai, iš ryto išperka.",
   "Tai ryt anksčiau užsuksiu."
  ],
  [
   "Prie Jozitos už stovėjimą reikia mokėt?",
   "Ne, čia ne mėlyna zona.",
   "Gerai, o tai jau automato ieškojau."
  ]
 ],
