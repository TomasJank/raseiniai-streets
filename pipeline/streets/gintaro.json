 "flavour": [
  [
   "Vėl tas autobusas pro mus nevažiuoja.",
   "Iki stotelės pėsčiom dešimt minučių.",
   "Su krepšiais ne dešimt, o visas pusvalandis.",
   "Tai sūnaus paprašyk, tegu atveža."
  ],
  [
   "Jūsų obelys šiemet lūžta nuo obuolių.",
   "Imkit kibirą, man visų nesuvalgyt.",
   "Tai aš jums pyrago atnešiu."
  ],
  [
   "Kas čia prie Aivaro vartų vėl stovi?",
   "Draugai atvažiavo, visą vakarą muzika.",
   "Kad tik iki dvyliktos.",
   "Jaunimas, ką padarysi."
  ],
  [
   "Ar jau kapinėse buvot prieš Vėlines?",
   "Buvau, žvakių prinešiau ir lapus sugrėbiau.",
   "O aš vis nespėju, gal šeštadienį."
  ]
